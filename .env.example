# ==============================================================================
# Gmail Bulk Sender - Environment Configuration
# ==============================================================================

# 1. Google Cloud OAuth 2.0 Credentials
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
# Create an OAuth 2.0 Client ID with Application type "Web application"
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 2. Application URL (used for redirects and callback origins)
APP_URL=http://localhost:3000

# 3. Session & Token Security
# SESSION_SECRET: Used for signing session cookies and OAuth CSRF state
SESSION_SECRET=replace-with-a-random-secure-string-at-least-32-chars

# TOKEN_ENCRYPTION_KEY: 32-byte hex string (64 characters) for AES-256-GCM encryption of stored OAuth refresh tokens at rest.
# Generate on Windows PowerShell with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 4. Master Passcode Protection (Protects your dashboard from unauthorized public access)
APP_PASSWORD=mailsprint2026!

# 4. Database (PostgreSQL for Render or hosted DB)
# Render Internal: postgres://user:password@hostname:5432/dbname
# Render External: postgresql://user:password@hostname/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/bulkmail?sslmode=prefer"

# 5. File Upload Storage (Private directory outside web root)
UPLOAD_DIR="./private-uploads"
